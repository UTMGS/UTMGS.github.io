---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout
	title="Acknowledgment | UTMGS"
	description="UTMGSとJOHNを支えてくださる皆さまへの感謝。"
	showNav
>
	<main class="page page--acknowledgment">
		<img src="/assets/brand/logo.jpg" alt="UTMGS ロゴ" class="logo" />
		<section class="acknowledgment" aria-labelledby="acknowledgment-heading">
			<h1 id="acknowledgment-heading">Acknowledgment</h1>
			<div class="acknowledgment__group">
				<h2>UTMGS</h2>
				<ul>
					<li data-type="individual">Sennin</li>
					<li data-type="individual">Dragon</li>
					<li data-type="individual">Kondoyan</li>
					<li data-type="individual">KJ</li>
					<li data-type="individual" hidden>Takagi-shi</li>
					<li data-type="individual" hidden>Kaneyan</li>
					<li data-type="individual">Ryopey-chan</li>
					<li>...and all Yantes.</li>
				</ul>
			</div>
			<div class="acknowledgment__group">
				<h2>JOHN</h2>
				<ul>
					<li data-type="individual">Ryopey-chan</li>
					<li data-type="individual">ShibaYu</li>
					<li data-type="individual">Kubocchi</li>
					<li data-type="individual">Fuji-kun</li>
					<li data-type="individual">Imai-san</li>
					<li data-type="individual">Seki-kun</li>
					<li data-type="individual">Mori-kun</li>
					<li data-type="individual">Okubo-kun</li>
					<li>...and all JOHN Players.</li>
				</ul>
			</div>
		</section>
	</main>
</SiteLayout>
