---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout>
	<main class="page">
		<img src="/assets/brand/logo.jpg" alt="UTMGS ロゴ" class="logo" />
		<div class="social-links">
			<a class="social-link" href="https://x.com/UTMGS_SUS" target="_blank" rel="noopener noreferrer">
				<span class="social-link__mark social-link__mark--large" aria-hidden="true">
					<img src="/assets/social/x-logo.svg" alt="" class="social-link__logo" />
				</span>
				<span class="social-link__copy">
					<span class="social-link__handle">@UTMGS_SUS</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="https://note.com/utmgs" target="_blank" rel="noopener noreferrer">
				<span class="social-link__mark social-link__mark--large social-link__mark--note" aria-hidden="true">note</span>
				<span class="social-link__copy">
					<span class="social-link__handle">note.com/utmgs</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="/blog/">
				<span class="social-link__copy">
					<span class="social-link__handle">UTMGS Blog</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="/acknowledgment/">
				<span class="social-link__copy">
					<span class="social-link__handle">Acknowledgment</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
		</div>
	</main>
</SiteLayout>
