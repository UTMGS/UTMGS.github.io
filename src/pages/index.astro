---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout>
	<main class="page">
		<img src="/assets/brand/logo.jpg" alt="UTMGS ロゴ" class="logo" />
		<div class="social-links">
			<a class="social-link" href="https://x.com/UTMGS_SUS" target="_blank" rel="noopener noreferrer">
				<span class="social-link__mark social-link__mark--large" aria-hidden="true">
					<img src="/assets/social/x-logo.svg" alt="" class="social-link__logo" />
				</span>
				<span class="social-link__copy">
					<span class="social-link__handle">@UTMGS_SUS</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="https://note.com/utmgs" target="_blank" rel="noopener noreferrer">
				<span class="social-link__mark social-link__mark--large social-link__mark--note" aria-hidden="true">note</span>
				<span class="social-link__copy">
					<span class="social-link__handle">note.com/utmgs</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="/blog/">
				<span class="social-link__copy">
					<span class="social-link__handle">UTMGS Blog</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
			<a class="social-link" href="/blog/hello-world/">
				<span class="social-link__copy">
					<span class="social-link__handle">ブログのサンプル記事</span>
				</span>
				<span class="social-link__arrow" aria-hidden="true">&#8599;</span>
			</a>
		</div>
		<section class="acknowledgment" aria-labelledby="acknowledgment-heading">
			<h2 id="acknowledgment-heading">Acknowledgment</h2>
			<div class="acknowledgment__group">
				<h3>UTMGS</h3>
				<ul>
					<li data-type="individual">Sennin</li>
					<li data-type="individual">Dragon</li>
					<li data-type="individual">Kondoyan</li>
					<li data-type="individual">KJ</li>
					<li data-type="individual" hidden>Takagi-shi</li>
					<li data-type="individual" hidden>Kaneyan</li>
					<li data-type="individual">Ryopey-chan</li>
					<li>...and all Yantes.</li>
				</ul>
			</div>
			<div class="acknowledgment__group">
				<h3>JOHN</h3>
				<ul>
					<li data-type="individual">Ryopey-chan</li>
					<li data-type="individual">ShibaYu</li>
					<li data-type="individual">Kubocchi</li>
					<li data-type="individual">Fuji-kun</li>
					<li data-type="individual">Imai-san</li>
					<li data-type="individual">Seki-kun</li>
					<li data-type="individual">Mori-kun</li>
					<li data-type="individual">Okubo-kun</li>
					<li>...and all JOHN Players.</li>
				</ul>
			</div>
		</section>
	</main>
</SiteLayout>
